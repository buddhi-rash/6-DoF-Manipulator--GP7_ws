<?xml version="1.0"?>
<!-- Box A: 30 cm x 30 cm x 20 cm, static (the place target). Spawn it with z = 0.10 (half the height). -->
<sdf version="1.10">
  <model name="box_a">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.30 0.30 0.20</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.30 0.30 0.20</size></box></geometry>
        <material>
          <ambient>0.85 0.45 0.10 1</ambient>
          <diffuse>0.85 0.45 0.10 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
