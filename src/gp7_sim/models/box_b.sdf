<?xml version="1.0"?>
<!-- Box B: 5 cm cube, 0.1 kg (the object to pick). Spawn it with z = 0.025 (half the height). -->
<sdf version="1.10">
  <model name="box_b">
    <link name="link">
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>4.1667e-5</ixx><iyy>4.1667e-5</iyy><izz>4.1667e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        <surface>
          <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        <material>
          <ambient>0.10 0.65 0.15 1</ambient>
          <diffuse>0.10 0.65 0.15 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
