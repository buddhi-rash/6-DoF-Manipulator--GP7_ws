<?xml version="1.0"?>
<!--
  Simplified parallel gripper (the CAD model has no end effector).
  Frame convention: +X of the parent frame (flange) is the tool axis, fingers open/close along Y.
  Fingertip is 0.14 m from the flange. Open gap = 80 mm, closed on a 50 mm box when each finger
  has moved ~15 mm inward.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="gripper_grey"><color rgba="0.35 0.35 0.38 1.0"/></material>
  <material name="gripper_black"><color rgba="0.05 0.05 0.05 1.0"/></material>

  <xacro:macro name="gp7_gripper" params="parent">

    <link name="gripper_base">
      <visual>
        <origin xyz="0.02 0 0" rpy="0 0 0"/>
        <geometry><box size="0.04 0.10 0.05"/></geometry>
        <material name="gripper_grey"/>
      </visual>
      <!-- collision box is 10 mm shorter than the visual so it never touches the fingers (they start at x = 0.04) -->
      <collision>
        <origin xyz="0.015 0 0" rpy="0 0 0"/>
        <geometry><box size="0.03 0.10 0.05"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.02 0 0" rpy="0 0 0"/>
        <mass value="0.4"/>
        <inertia ixx="4.1667e-4" ixy="0" ixz="0" iyy="1.3667e-4" iyz="0" izz="3.8667e-4"/>
      </inertial>
    </link>
    <joint name="flange_to_gripper" type="fixed">
      <parent link="${parent}"/>
      <child link="gripper_base"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Finger. BOTH fingers use the identical joint definition (axis 0 -1 0 in the joint frame,
         limits 0..0.02, positive = closing). The right finger is mounted with yaw = pi, so its
         -Y axis points to +Y in the gripper frame. Because the joint frame is turned around,
         the finger box sits at x = -0.09 in its own frame (= +0.09 in the gripper frame).
         Finger mass 0.2 kg and effort 20 N keep the contact solver well conditioned. -->
    <xacro:macro name="gp7_finger" params="side y_pos yaw gx">
      <link name="finger_${side}">
        <visual>
          <origin xyz="${gx} 0 0" rpy="0 0 0"/>
          <geometry><box size="0.10 0.012 0.03"/></geometry>
          <material name="gripper_black"/>
        </visual>
        <collision>
          <origin xyz="${gx} 0 0" rpy="0 0 0"/>
          <geometry><box size="0.10 0.012 0.03"/></geometry>
        </collision>
        <inertial>
          <origin xyz="${gx} 0 0" rpy="0 0 0"/>
          <mass value="0.2"/>
          <inertia ixx="1.74e-5" ixy="0" ixz="0" iyy="1.8167e-4" iyz="0" izz="1.6907e-4"/>
        </inertial>
      </link>
      <joint name="finger_${side}_joint" type="prismatic">
        <parent link="gripper_base"/>
        <child link="finger_${side}"/>
        <origin xyz="0 ${y_pos} 0" rpy="0 0 ${yaw}"/>
        <axis xyz="0 -1 0"/>   <!-- positive travel = towards the centre line, for both fingers -->
        <!-- Working range is 0 (open) .. 0.02 (closed). The limits are deliberately a little WIDER than
             that: Gazebo's physics engine (DART) can pin a joint that sits exactly on a limit, which
             left one finger stuck. Never command outside 0 .. 0.02. -->
        <limit lower="-0.005" upper="0.025" effort="20" velocity="0.2"/>
      </joint>
      <!-- friction so a 5 cm box does not slip (read by the URDF->SDF converter) -->
      <gazebo reference="finger_${side}">
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
      </gazebo>
    </xacro:macro>

    <xacro:gp7_finger side="left"  y_pos="0.046"  yaw="0"          gx="0.09"/>
    <xacro:gp7_finger side="right" y_pos="-0.046" yaw="${pi}"      gx="-0.09"/>

  </xacro:macro>
</robot>
